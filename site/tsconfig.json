{
  // Extends Astro's own strict preset, not ../tsconfig.base.json: the base's
  // `composite` + `noEmit`, `types: ["node"]` and `allowImportingTsExtensions`
  // conflict with Astro's. `astro check` is this package's type gate.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
}
