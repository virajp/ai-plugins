---
// The construction drawing of the mark: the only illustration on the site.
// White lines on a blueprint panel, construction guides at 45%.
interface Props {
  size?: number;
  class?: string;
}
const { size = 400, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <g stroke="#fff" stroke-width=".3" opacity=".45">
    <line x1="10" y1="0" x2="10" y2="64" />
    <line x1="32" y1="0" x2="32" y2="64" />
    <line x1="54" y1="0" x2="54" y2="64" />
    <line x1="0" y1="8" x2="64" y2="8" />
    <line x1="0" y1="18" x2="64" y2="18" />
    <line x1="0" y1="56" x2="64" y2="56" />
  </g>
  <g stroke="#fff" stroke-width="2.2" stroke-linecap="round">
    <line x1="10" y1="8" x2="54" y2="8" />
    <line x1="10" y1="4.5" x2="10" y2="11.5" />
    <line x1="54" y1="4.5" x2="54" y2="11.5" />
    <line x1="10" y1="18" x2="32" y2="56" />
    <line x1="54" y1="18" x2="32" y2="56" />
    <circle cx="10" cy="18" r="3.4" fill="#1e3f8f" />
    <circle cx="54" cy="18" r="3.4" fill="#1e3f8f" />
    <circle cx="32" cy="56" r="3.4" fill="#fff" />
  </g>
</svg>
