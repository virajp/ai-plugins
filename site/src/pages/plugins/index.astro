---
import { getCollection } from "astro:content";

import Docs from "../../layouts/Docs.astro";
import { routeFor } from "../../lib/routes.ts";

// The Plugins section has no index.md, so its route is generated: the entries
// under plugins/, in their frontmatter order, each with its description.
const entries = (await getCollection("docs"))
  .filter(e => e.id.startsWith("plugins/"))
  .sort((a, b) => a.data.order - b.data.order);
---

<Docs
  id="plugins/index"
  title="Plugins"
  description="The reference for each plugin the marketplace ships, command by command."
>
  <p>
    Two plugins ship from the marketplace, and two more documents describe what
    ships inside them. Each page is the reference for one of them.
  </p>
  <ul class="entries">
    {entries.map(e => (
      <li>
        <a href={routeFor(e.id)}>{e.data.title}</a>
        <p>{e.data.description}</p>
      </li>
    ))}
  </ul>
</Docs>

<style>
  .entries {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    border-top: 1px solid var(--line-2);
  }
  .entries li {
    padding: 20px 0;
    border-bottom: 1px solid var(--line-2);
    margin: 0;
  }
  .entries a {
    font-size: 20px;
    font-weight: 700;
    color: var(--paper);
    text-decoration: none;
  }
  .entries a:hover {
    color: var(--blue-3);
  }
  .entries p {
    margin: 6px 0 0;
    font-size: 15px;
  }
</style>
