.claude/settings.local.json

# Graphify
graphify-out/

# OpenCode project config — dev-local state written by
# `graphify install --platform opencode` (and installer smoke runs); this
# repo ships OpenCode support but is not itself OpenCode-configured.
.opencode/

# ============================================================
# Node / CLI
# ============================================================
node_modules/

# TypeScript build artifacts. Note the name collision: the ROOT dist/ is the
# rendered plugin output and IS committed — these per-package dist/ dirs are
# compiler output and are not.
schema/dist/
build/dist/
cli/dist/
*.tsbuildinfo

# Build output: tsup bundles cli/ into bin/, and bin/ is what npm publishes.
# Not committed — unlike the root dist/, which is a *rendered* tree meant to be
# diffed in review. A bundle diff is noise, and `i:build` regenerates it before
# every publish. Note the asymmetry: root dist/ is committed, bin/ is not.
bin/

# Per-platform binaries and their archives, assembled by `i:binaries`. Build
# output like bin/, and far too large to commit — each archive carries a 61 MB
# Bun runtime beside a copy of the 12 MB dist/ payload.
release/

# Working notes and session handoffs — personal state, not the team's.
docs/scratchpad/
