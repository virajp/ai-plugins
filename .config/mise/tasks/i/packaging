#!/usr/bin/env bash
#MISE description="Generate the Homebrew formula and Scoop manifest from the built archives"
#MISE dir="{{ config_root }}"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

# Both files pin a version and a sha256 per platform, so both are DERIVED from
# the archives `i:binaries` just built. Hand-maintaining them means a checksum
# that is wrong exactly once per release, and a formula that fails for everyone
# until someone notices.
VERSION="$(node -p 'require("./package.json").version')"
OUT="release"
SUMS="$OUT/checksums-$VERSION.txt"

[[ -f "$SUMS" ]] || {
  print_error "no $SUMS — run 'mise run i:binaries' first"
  exit 1
}

sum_for() {
  grep " ai-plugins-$VERSION-$1\$" "$SUMS" | awk '{print $1}'
}

REPO_URL="https://github.com/virajp/ai-plugins/releases/download/v$VERSION"

print_header "Writing the Homebrew formula ..."
cat > "$OUT/ai-plugins.rb" <<RUBY
# Generated by \`mise run i:packaging\` — do not edit by hand.
# Copy into the tap repo (virajp/homebrew-tap) as Formula/ai-plugins.rb.
class AiPlugins < Formula
  desc "Install Viraj Patel's AI coding toolkit across five agents"
  homepage "https://github.com/virajp/ai-plugins"
  version "$VERSION"
  license "MIT"

  on_macos do
    on_arm do
      url "$REPO_URL/ai-plugins-$VERSION-darwin-arm64.tar.gz"
      sha256 "$(sum_for darwin-arm64.tar.gz)"
    end
    on_intel do
      url "$REPO_URL/ai-plugins-$VERSION-darwin-x64.tar.gz"
      sha256 "$(sum_for darwin-x64.tar.gz)"
    end
  end

  on_linux do
    on_arm do
      url "$REPO_URL/ai-plugins-$VERSION-linux-arm64.tar.gz"
      sha256 "$(sum_for linux-arm64.tar.gz)"
    end
    on_intel do
      url "$REPO_URL/ai-plugins-$VERSION-linux-x64.tar.gz"
      sha256 "$(sum_for linux-x64.tar.gz)"
    end
  end

  def install
    # The whole tree goes to libexec and only the executable is linked. The
    # binary reads dist/ from beside itself — three adapters register a
    # marketplace whose source is a real directory in there, re-read in place on
    # every later session — so splitting them would break every install.
    libexec.install Dir["*"]
    bin.install_symlink libexec/"ai-plugins"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/ai-plugins --version")
  end
end
RUBY

print_header "Writing the Scoop manifest ..."
cat > "$OUT/ai-plugins.json" <<JSON
{
  "\$comment": "Generated by 'mise run i:packaging' — do not edit by hand. Copy into the bucket repo (virajp/scoop-bucket) as bucket/ai-plugins.json.",
  "version": "$VERSION",
  "description": "Install Viraj Patel's AI coding toolkit across five agents",
  "homepage": "https://github.com/virajp/ai-plugins",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "$REPO_URL/ai-plugins-$VERSION-windows-x64.zip",
      "hash": "$(sum_for windows-x64.zip)",
      "extract_dir": "ai-plugins-$VERSION-windows-x64"
    }
  },
  "bin": "ai-plugins.exe",
  "checkver": {
    "github": "https://github.com/virajp/ai-plugins"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/virajp/ai-plugins/releases/download/v\$version/ai-plugins-\$version-windows-x64.zip",
        "extract_dir": "ai-plugins-\$version-windows-x64"
      }
    },
    "hash": {
      "url": "https://github.com/virajp/ai-plugins/releases/download/v\$version/checksums-\$version.txt"
    }
  }
}
JSON

print_header "Generated:"
echo "  $OUT/ai-plugins.rb    → virajp/homebrew-tap  Formula/ai-plugins.rb"
echo "  $OUT/ai-plugins.json  → virajp/scoop-bucket  bucket/ai-plugins.json"
