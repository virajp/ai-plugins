#!/usr/bin/env bash
#MISE description="Smoke-test the built installer CLI (non-mutating)"
#MISE dir="{{ config_root }}"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

# Test the BUILT artifact, not the source. bin/ is what npm ships, and the
# bundle is where a packaging mistake would show up — a missing external, a
# broken package-root resolution — none of which `node cli/src/index.ts` can
# expose, because in the repo everything resolves through the workspace.
print_header "Bundling cli/ into bin/ ..."
pnpm exec tsup >/dev/null

CLI=(node bin/installer.mjs)

print_header "Rendering --help ..."
"${CLI[@]}" --help >/dev/null

# The invocations below never mutate anything: each exits before an install runs.
print_header "Asserting no flags exits non-zero ..."
if "${CLI[@]}" >/dev/null 2>&1; then
  print_error "Expected non-zero exit with no flags"
  exit 1
fi

# `strict` parsing is what makes a retired flag answer by name instead of being
# a silent no-op — a user with one in a script is told, rather than watching a
# run do less than they asked for. --statusline, --no-statusline and --force
# joined this list when the statusline left.
print_header "Asserting every retired flag is rejected ..."
for flag in --platform --upgrade --statusline --no-statusline --force; do
  if "${CLI[@]}" "$flag" claude >/dev/null 2>&1; then
    print_error "Expected non-zero exit for a retired flag (${flag})"
    exit 1
  fi
done

# ---------------------------------------------------------------------------
# End-to-end, against the BUILT bundle and a throwaway HOME.
#
# Everything above this line exits before anything is read or written. What
# follows covers the one thing this version can break invisibly: a machine
# upgrading from v5.2.0 carries a `statusline.json` receipt recording the bar
# our statusline displaced. This CLI no longer installs a statusline and has no
# `statusline` removal kind — so unless that receipt is read as a LEGACY one,
# `--uninstall` stops finding it and the user's own bar never comes back, while
# reporting a clean uninstall.
#
# It is seeded here rather than produced, because nothing in this version can
# produce it: the writer went with the bar. The fixture below is the shape
# v5.2.0 wrote.
#
# `claude` is stubbed because the plugin install path is exercised as
# `--dry-run` only — driving a real install through a stub would test this tool
# against our own fiction of Claude's CLI. The command *sequence* is covered by
# the vitest suite with an injected fake exec.
# ---------------------------------------------------------------------------
print_header "Setting up a throwaway HOME ..."


E2E_HOME="$(mktemp -d)"
trap 'rm -rf "$E2E_HOME"' EXIT

NODE_DIR="$(dirname "$(command -v node)")"
mkdir -p "$E2E_HOME/bin" "$E2E_HOME/.claude/scripts"
printf '#!/bin/sh\nexit 0\n' >"$E2E_HOME/bin/claude"
chmod +x "$E2E_HOME/bin/claude"

# HOME drives `context.home`; the two XDG vars keep the receipt and the user
# config inside the throwaway too. Without all three a "hermetic" run still
# writes into the developer's own config.
e2e() {
  env \
    PATH="$NODE_DIR:$E2E_HOME/bin" \
    HOME="$E2E_HOME" \
    XDG_CONFIG_HOME="$E2E_HOME/.config" \
    XDG_DATA_HOME="$E2E_HOME/.local/share" \
    "${CLI[@]}" "$@"
}

# The plugin install path, dry only: the bundle must parse the flags and
# describe the claude commands it would run, without writing anything.
print_header "Asserting --user vwf --dry-run describes the claude commands ..."
before_plugins="$(find "$E2E_HOME" -type f | sort)"
plugin_dry="$(e2e --user vwf --dry-run)"
for expected in \
  "claude plugin marketplace add virajp/ai-plugins" \
  "claude plugin install vwf@virajp-plugins --scope user"; do
  if ! grep -qF "$expected" <<<"$plugin_dry"; then
    print_error "--user vwf --dry-run did not describe: $expected"
    printf '%s\n' "$plugin_dry"
    exit 1
  fi
done
after_plugins="$(find "$E2E_HOME" -type f | sort)"
if [[ "$before_plugins" != "$after_plugins" ]]; then
  print_error "--user vwf --dry-run wrote something; it must write nothing"
  exit 1
fi

# --- The v5.2.0 migration ---------------------------------------------------
#
# The state a machine on the previous release is in: our bar configured in
# settings.json, our script on disk, and a receipt recording the FOREIGN bar
# that was there first.
print_header "Seeding a v5.2.0 statusline install ..."

FOREIGN="/opt/somebody-elses/bar.sh"
SETTINGS="$E2E_HOME/.claude/settings.json"
SCRIPT="$E2E_HOME/.claude/scripts/statusline"
RECEIPT_DIR="$E2E_HOME/.config/ai-plugins/receipts"
RECEIPT="$RECEIPT_DIR/statusline.json"

printf '#!/usr/bin/env node\n// the bar v5.2.0 installed\n' >"$SCRIPT"
chmod +x "$SCRIPT"
cat >"$SETTINGS" <<'JSON'
{
  "statusLine": {
    "type": "command",
    "command": "${HOME}/.claude/scripts/statusline"
  }
}
JSON

mkdir -p "$RECEIPT_DIR"
cat >"$RECEIPT" <<JSON
{
  "version": 3,
  "installedAt": "2026-08-01T00:00:00Z",
  "entries": [
    { "kind": "dir", "path": "${E2E_HOME}/.claude/scripts" },
    { "kind": "file", "path": "${SCRIPT}" },
    {
      "kind": "configKey",
      "file": "${SETTINGS}",
      "path": ["statusLine"],
      "hadKey": true,
      "previous": { "type": "command", "command": "${FOREIGN}" }
    }
  ]
}
JSON

# What this proves, and what it deliberately leaves to vitest.
#
# The dry run is the whole reachable half here: `--uninstall` is interactive by
# design and refuses without a TTY, and allocating one portably is a BSD-vs-GNU
# `script` trap this repo already pays elsewhere. So the CLI-level assertion is
# that the built bundle, resolving HOME and both XDG vars for real, FINDS the
# v5.2.0 receipt at the path v5.2.0 wrote it to — which is the half that breaks
# if `statusline.json` falls out of `LEGACY_RECEIPTS`.
#
# The restore itself — settings.json carrying the foreign command again, byte
# for byte — is asserted in `uninstall.test.ts`, against a real temp filesystem
# through the same `revertLegacyReceipt` path this run would take.
print_header "Asserting --uninstall --dry-run finds the v5.2.0 receipt ..."
# Both streams: the enumerated list goes to stderr (it is a question, even in
# dry-run form) and the diff to stdout, and this asserts against each.
dry_out="$(e2e --uninstall --dry-run 2>&1)"
if ! grep -qi "statusline" <<<"$dry_out"; then
  print_error "--uninstall --dry-run did not list the statusline receipt"
  print_warn  "Is statusline.json still in LEGACY_RECEIPTS?"
  printf '%s\n' "$dry_out"
  exit 1
fi
if ! grep -qF "$RECEIPT" <<<"$dry_out"; then
  print_error "--uninstall --dry-run did not name ${RECEIPT}"
  print_warn  "It found something, but not the receipt v5.2.0 actually wrote."
  printf '%s\n' "$dry_out"
  exit 1
fi
if ! grep -qF "revert" <<<"$dry_out"; then
  print_error "--uninstall --dry-run described no revert for it"
  print_warn  "A delete rather than a revert would leave the user with no bar."
  printf '%s\n' "$dry_out"
  exit 1
fi
if [[ ! -f "$SCRIPT" || ! -f "$RECEIPT" ]]; then
  print_error "--uninstall --dry-run removed something; it must write nothing"
  exit 1
fi
if ! grep -q "scripts/statusline" "$SETTINGS"; then
  print_error "--uninstall --dry-run edited settings.json; it must write nothing"
  exit 1
fi

print_header "Asserting --uninstall refuses without a terminal ..."
# The rule the dry run exists beside: an unattended run must not guess which
# pieces the user wanted kept.
if e2e --uninstall </dev/null >/dev/null 2>&1; then
  print_error "Expected non-zero exit for --uninstall with no TTY to ask on"
  exit 1
fi

rm -rf "$E2E_HOME"
trap - EXIT

print_header "Running the vitest suites ..."
pnpm exec vitest run

print_header "All installer smoke tests passed!"
