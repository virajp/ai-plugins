#!/usr/bin/env bash
#MISE description="Smoke-test the built installer CLI (non-mutating)"
#MISE dir="{{ config_root }}"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

if [[ ! -d node_modules/citty ]]; then
  print_header "Installing dependencies ..."
  pnpm install
fi

# Test the BUILT artifact, not the source. bin/ is what npm ships, and the
# bundle is where a packaging mistake would show up — a missing external, a
# broken package-root resolution — none of which `node cli/src/index.ts` can
# expose, because in the repo everything resolves through the workspace.
print_header "Bundling cli/ into bin/ ..."
pnpm exec tsup >/dev/null

CLI=(node bin/ai-plugins.mjs)

print_header "Rendering --help ..."
"${CLI[@]}" --help >/dev/null

# The invocations below never mutate anything: each exits before an install runs.
print_header "Asserting no flags exits non-zero ..."
if "${CLI[@]}" >/dev/null 2>&1; then
  print_error "Expected non-zero exit with no flags"
  exit 1
fi

print_header "Asserting unknown plugin is rejected ..."
if "${CLI[@]}" --user bogus >/dev/null 2>&1; then
  print_error "Expected non-zero exit for an unknown plugin"
  exit 1
fi

print_header "Asserting an unknown platform is rejected ..."
if "${CLI[@]}" --platform bogus --user vwf >/dev/null 2>&1; then
  print_error "Expected non-zero exit for --platform bogus"
  exit 1
fi

print_header "Asserting no-detectable-platform exits non-zero ..."
# With only node on PATH no agent CLI resolves, so auto-detection finds nothing.
NODE_DIR="$(dirname "$(command -v node)")"
if env PATH="$NODE_DIR" "${CLI[@]}" --user vwf >/dev/null 2>&1; then
  print_error "Expected non-zero exit when no platform is detectable"
  exit 1
fi

# The external-tool gate: vwf needs graphify/rtk/mise/pnpm/uv, none of which are
# on a node-only PATH. The list is derived from each plugin's `requires:` via
# plugins.json, so this also proves that projection survived the build.
print_header "Asserting the missing-tool gate fires ..."
if env PATH="$NODE_DIR" "${CLI[@]}" --platform claude --user vwf >/dev/null 2>&1; then
  print_error "Expected non-zero exit when required tools are missing"
  exit 1
fi

# Asserted positively, not just by the absence of the missing-tool line. An
# unknown plugin name exits early with "unknown plugin", which also lacks that
# line — so the negative form passed vacuously for as long as the plugin it
# named did not exist. It did exactly that once, after `markdown` folded into
# vwf. Requiring the run to reach the per-target skip proves the name resolved.
print_header "Asserting per-plugin tools: datastore needs none ..."
datastore_out="$(env PATH="$NODE_DIR" "${CLI[@]}" --platform claude --user datastore 2>&1)"
if grep -q "missing required tool" <<<"$datastore_out"; then
  print_error "datastore should require no external tools"
  exit 1
fi
if ! grep -qE 'claude[[:space:]]+.*tool not on PATH' <<<"$datastore_out"; then
  print_error "datastore did not resolve to a known plugin"
  printf '%s\n' "$datastore_out"
  exit 1
fi

print_header "Asserting per-plugin tools: devtools needs mise ..."
if ! env PATH="$NODE_DIR" "${CLI[@]}" --platform claude --user devtools 2>&1 | grep -qE '^  mise '; then
  print_error "the devtools plugin should require mise"
  exit 1
fi

# ---------------------------------------------------------------------------
# End-to-end: install, install again, uninstall — against the BUILT bundle.
#
# Everything above this line exits before an adapter runs, so until now nothing
# here ever wrote a file. The 3.0.x bug class only ever showed up on a repeat
# run, and the unit tests that cover it use fakes.
#
# OpenCode is the target used because its adapter shells out to nothing: the
# binary only has to exist for `detect()`, and every write below is the real
# copy, prune, ownership record, config merge and receipt. Stubbing `claude` or
# `omp` instead would test this tool against our own fiction of their CLIs —
# their command sequences are already covered by the adapter suites, and the
# packaging risk this file exists for (a missing external, a broken package-root
# walk) is identical whichever adapter runs the bundle.
# ---------------------------------------------------------------------------
print_header "Installing twice, then uninstalling, against a throwaway HOME ..."

E2E_HOME="$(mktemp -d)"
trap 'rm -rf "$E2E_HOME"' EXIT

mkdir -p "$E2E_HOME/bin"
printf '#!/bin/sh\nexit 0\n' >"$E2E_HOME/bin/opencode"
chmod +x "$E2E_HOME/bin/opencode"

# HOME drives `context.home`; the two XDG vars keep the receipt and any managed
# payload inside the throwaway too. Without all three a "hermetic" run still
# writes into the developer's own config.
e2e() {
  env \
    PATH="$NODE_DIR:$E2E_HOME/bin" \
    HOME="$E2E_HOME" \
    XDG_CONFIG_HOME="$E2E_HOME/.config" \
    XDG_DATA_HOME="$E2E_HOME/.local/share" \
    "${CLI[@]}" "$@"
}

E2E_CONFIG="$E2E_HOME/.config/opencode"

# `datastore` is the plugin asserted above to require no external tools, so the
# run reaches the adapter instead of stopping at the dependency gate.
if ! e2e --platform opencode --user datastore >/dev/null; then
  print_error "First install failed"
  exit 1
fi
if [[ ! -d "$E2E_CONFIG/virajp-plugins/datastore" ]]; then
  print_error "First install wrote no bundle"
  exit 1
fi
first="$(cd "$E2E_CONFIG" && find . -type f | sort)"

if ! e2e --platform opencode --user datastore >/dev/null; then
  print_error "Second install failed — the repeat-run path is broken"
  exit 1
fi
second="$(cd "$E2E_CONFIG" && find . -type f | sort)"

if [[ "$first" != "$second" ]]; then
  print_error "Second install changed the tree; it must be idempotent"
  diff <(printf '%s\n' "$first") <(printf '%s\n' "$second") || true
  exit 1
fi

if ! e2e --platform opencode --uninstall >/dev/null; then
  print_error "Uninstall failed"
  exit 1
fi
if [[ -d "$E2E_CONFIG/virajp-plugins" ]]; then
  print_error "Uninstall left the bundle behind"
  find "$E2E_CONFIG/virajp-plugins" | head -20
  exit 1
fi

rm -rf "$E2E_HOME"
trap - EXIT

print_header "Running the vitest suites ..."
pnpm exec vitest run

print_header "All installer smoke tests passed!"
