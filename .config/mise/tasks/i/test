#!/usr/bin/env bash
#MISE description="Smoke-test the built installer CLI (non-mutating)"
#MISE dir="{{ config_root }}"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

# Test the BUILT artifact, not the source. bin/ is what npm ships, and the
# bundle is where a packaging mistake would show up — a missing external, a
# broken package-root resolution — none of which `node cli/src/index.ts` can
# expose, because in the repo everything resolves through the workspace.
print_header "Bundling cli/ into bin/ ..."
pnpm exec tsup >/dev/null

CLI=(node bin/ai-plugins.mjs)
STATUSLINE="tools/statusline/statusline"

print_header "Rendering --help ..."
"${CLI[@]}" --help >/dev/null

# The invocations below never mutate anything: each exits before an install runs.
print_header "Asserting no flags exits non-zero ..."
if "${CLI[@]}" >/dev/null 2>&1; then
  print_error "Expected non-zero exit with no flags"
  exit 1
fi

print_header "Asserting an unknown flag is rejected ..."
if "${CLI[@]}" --platform claude >/dev/null 2>&1; then
  print_error "Expected non-zero exit for a retired flag (--platform)"
  exit 1
fi

# The one assertion that makes the hand-synced version safe.
#
# The statusline reports its own version from a hardcoded constant, because the
# CLI cannot report what is on disk otherwise: under `pnpx` the running package
# is whatever was just downloaded, not what the user installed. `i:version`
# stamps that constant during the bump; this is what catches a bump that edited
# package.json and missed the script — which would ship a bar lying about its
# own version, silently, since nothing else ever compares them.
print_header "Asserting the statusline reports package.json's version ..."
PKG_VERSION="$(node -p "require('./package.json').version")"
SCRIPT_VERSION="$("${STATUSLINE}" --version)"
if [[ "${SCRIPT_VERSION}" != "${PKG_VERSION}" ]]; then
  print_error "${STATUSLINE} reports ${SCRIPT_VERSION}, package.json says ${PKG_VERSION}"
  print_warn  "Run 'mise run i:version' to stamp it, or fix the constant by hand."
  exit 1
fi

# ---------------------------------------------------------------------------
# End-to-end: install, install again, then the two non-interactive uninstall
# paths — against the BUILT bundle and a throwaway HOME.
#
# Everything above this line exits before anything is written. The bug class this
# section exists for only ever showed up on a REPEAT run: an install that records
# its own output as the state to restore, so the uninstall gives the user our bar
# back instead of theirs. The unit tests cover that with fakes; this covers it
# against the real filesystem and the real bundle.
#
# `claude` is stubbed because the statusline install only needs it to exist —
# nothing here shells out to it. The plugin install path that did shell out is
# gone: plugins are installed by `claude plugin install` from the GitHub-served
# marketplace, and this CLI no longer has a hand in it.
# ---------------------------------------------------------------------------
print_header "Installing twice, then uninstalling, against a throwaway HOME ..."

E2E_HOME="$(mktemp -d)"
trap 'rm -rf "$E2E_HOME"' EXIT

NODE_DIR="$(dirname "$(command -v node)")"
mkdir -p "$E2E_HOME/bin" "$E2E_HOME/.claude"
printf '#!/bin/sh\nexit 0\n' >"$E2E_HOME/bin/claude"
chmod +x "$E2E_HOME/bin/claude"

# A statusline that is not ours, already in place. The install must record it and
# every later run must leave that record alone — that is the whole point below.
FOREIGN="/opt/somebody-elses/bar.sh"
cat >"$E2E_HOME/.claude/settings.json" <<JSON
{ "statusLine": { "type": "command", "command": "${FOREIGN}" } }
JSON

# HOME drives \`context.home\`; the two XDG vars keep the receipt and the user
# config inside the throwaway too. Without all three a "hermetic" run still
# writes into the developer's own config.
e2e() {
  env \
    PATH="$NODE_DIR:$E2E_HOME/bin" \
    HOME="$E2E_HOME" \
    XDG_CONFIG_HOME="$E2E_HOME/.config" \
    XDG_DATA_HOME="$E2E_HOME/.local/share" \
    "${CLI[@]}" "$@"
}

RECEIPT="$E2E_HOME/.config/ai-plugins/receipts/statusline.json"

# --statusline IS the consent to displace what is there; without it the run would
# stop rather than replace the foreign bar.
if ! e2e --statusline >/dev/null; then
  print_error "First install failed"
  exit 1
fi
if [[ ! -f "$E2E_HOME/.claude/scripts/statusline" ]]; then
  print_error "First install wrote no statusline script"
  exit 1
fi
if ! grep -q "$FOREIGN" "$RECEIPT"; then
  print_error "The receipt does not record the statusline that was there before"
  cat "$RECEIPT"
  exit 1
fi

# Content, not just filenames. The old version of this check compared `find`
# output, so it would have passed while a file's bytes changed underneath it.
# The receipt is excluded because `installedAt` is expected to move on every
# run; its *contents* are asserted separately, above and below, which is the
# claim that actually matters.
snapshot() {
  (cd "$E2E_HOME" \
    && find . -type f -not -path "./bin/*" -not -path "*/receipts/*" \
    | sort | xargs shasum)
}
first="$(snapshot)"

if ! e2e --statusline >/dev/null; then
  print_error "Second install failed — the repeat-run path is broken"
  exit 1
fi
if ! grep -q "$FOREIGN" "$RECEIPT"; then
  print_error "The repeat install overwrote the prior state with its own output"
  print_warn  "An uninstall would now restore OUR bar instead of the user's."
  cat "$RECEIPT"
  exit 1
fi

second="$(snapshot)"
if [[ "$first" != "$second" ]]; then
  print_error "Second install changed the tree; it must be idempotent"
  diff <(printf '%s\n' "$first") <(printf '%s\n' "$second") || true
  exit 1
fi

# --uninstall is interactive by design, so the two paths reachable without a
# terminal are what this asserts. Both matter: the dry run is how a script sees
# what is installed, and the refusal is what stops an unattended run from
# guessing which pieces the user wanted kept.
print_header "Asserting --uninstall --dry-run finds the statusline and writes nothing ..."
dry_out="$(e2e --uninstall --dry-run)"
if ! grep -q "statusline" <<<"$dry_out"; then
  print_error "--uninstall --dry-run did not list the statusline"
  printf '%s\n' "$dry_out"
  exit 1
fi
if [[ ! -f "$E2E_HOME/.claude/scripts/statusline" ]]; then
  print_error "--uninstall --dry-run removed something; it must write nothing"
  exit 1
fi

print_header "Asserting --uninstall refuses without a terminal ..."
if e2e --uninstall </dev/null >/dev/null 2>&1; then
  print_error "Expected non-zero exit for --uninstall with no TTY to ask on"
  exit 1
fi

rm -rf "$E2E_HOME"
trap - EXIT

print_header "Running the vitest suites ..."
pnpm exec vitest run

print_header "All installer smoke tests passed!"
