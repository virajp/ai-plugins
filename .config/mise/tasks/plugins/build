#!/usr/bin/env bash
#MISE description="Render templates/ into <repo>/<target>/ for every agent target"
#MISE dir="{{ config_root }}"

# Renders the authored, target-agnostic templates/ tree into the committed
# <repo>/<target>/ trees — one per agent (claude, opencode, cursor, ohmypi).
# Each target directory is removed first, so a deleted skill disappears from
# the output rather than lingering: the render must be a pure function of
# templates/, or `git status` stops meaning anything.
#
# The output is committed on purpose. What users install is then inspectable and
# diffable in review, and CI can assert the tree is clean after a render — which
# is what catches a template edit that was never rebuilt.
#
# Run with no build step: node strips the TypeScript types directly. That needs
# node >= 22.6, which .config/mise.toml already pins.

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

node --experimental-strip-types renderer/src/cli.ts render "$@"

# The rendered Oh-My-Pi bundles are the only part of the output carrying a
# package.json, and `code:format` checks every package.json in the repo against
# sort-package-json's canonical key order. Sorting here rather than hand-ordering
# the generator is what keeps the two from drifting the next time a key is added.
#
# `pnpm exec`, never `pnpm dlx`: this rewrites **committed** output, so an
# unpinned sorter that picked up a new upstream key order would fail
# `plugins:render-clean` in CI with nothing having changed locally. The pinned
# devDependency is what makes a render reproducible. `code:format` runs the same
# binary the same way, so the write and the check can never disagree.
print_header "Sorting rendered package.json files ..."
pnpm exec sort-package-json "ohmypi/*/package.json"
