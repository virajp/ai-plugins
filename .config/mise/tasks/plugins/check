#!/usr/bin/env bash
#MISE description="Static validation of templates/ and every rendered target, plus the coverage report"
#MISE dir="{{ config_root }}"

# Validates the authored templates/ tree and all five rendered targets, then
# prints the per-target coverage report.
#
# This is deliberately smaller than the Python task it replaces. The neutral
# manifest merged plugin.json with the marketplace entry, and the zod schemas
# type what used to be checked by regex, so whole families of the old
# assertions became unrepresentable rather than merely unchecked — the two
# dependency lists that had to agree, marketplace registration in both
# directions, skill name/description/model shape.
#
# What remains is what no type can state: cross-file agreement, things that must
# exist on disk, and the properties of the *rendered* output. That second half
# is the point — Claude has byte-parity against plugins/, and the other four
# targets have nothing else.
#
# Exits non-zero on any finding. The coverage report always prints, including on
# success: a capability silently disappearing from a target is exactly the kind
# of regression that otherwise goes unnoticed.

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

exec node --experimental-strip-types build/src/cli.ts check "$@"
