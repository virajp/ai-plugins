#!/usr/bin/env bash
#MISE description="Generate both marketplace manifests from the plugin manifests (--check to assert freshness)"
#MISE dir="{{ config_root }}"

# Projects the plugins/<name>/.claude-plugin/plugin.json manifests into the two
# marketplace manifests Claude Code reads.
#
#   .claude-plugin/marketplace.json                 PUBLISHED — what users read
#                                                   from main. Sources are
#                                                   git-subdir at a per-plugin
#                                                   tag, so a merge ships
#                                                   nothing until the tag is cut.
#   .dev-marketplace/.claude-plugin/marketplace.json
#                                                   LOCAL AUTHORING ONLY — never
#                                                   published. Sources are
#                                                   repo-relative paths into
#                                                   .dev-marketplace/plugins, a
#                                                   staging directory of copies
#                                                   that `plugins:local` writes,
#                                                   so this machine runs the
#                                                   working tree rather than
#                                                   the last release.
#
# The published one lives at the repo ROOT because every `source` inside it is
# root-relative and would resolve nowhere from anywhere else. The dev one needs
# its own directory for the same reason, plus the staging directory of copies —
# Claude rejects an absolute path, a {source: "directory"|"local", path} object,
# and a parent-relative ../plugins/<name>, so a repo-relative path that stays
# inside the marketplace root is the only accepted way to name a local tree.
#
# Both are written together rather than behind a --dev flag: a flag is one more
# thing to forget, and a stale dev manifest fails as a plugin quietly serving
# yesterday's tree.
#
# The published output is committed on purpose: what a user installs is then
# inspectable and diffable in review. That is also the only reason `--check` has
# to exist — a generated-and-committed file has no other staleness guarantee, so
# this mode is the successor to the retired `plugins:render-clean`.
#
# .dev-marketplace/ is GITIGNORED. It is one machine's local state, and a second
# committed file declaring the marketplace name `virajp-plugins` is a footgun on
# the branch users read. So `--check` reports an absent dev manifest as not
# applicable — the normal state in CI and in a fresh clone — and fails only on
# one that exists and is stale, or whose plugins path is the retired symlink.
# Until 2026-09-03 .dev-marketplace/plugins was a symlink to ../plugins, under
# which `claude plugin update` never saw an edit; the generator replaces one it
# finds with an empty staging directory, and `--check` fails on one it finds.
#
# Run with no build step: node strips the TypeScript types directly. That needs
# node >= 22.6, which .config/mise.toml already pins.

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

# "$@" so --check passes straight through. Deliberately not a #USAGE flag: mise
# would then own the parsing and the script would have to reconstruct the
# argument, which buys a help line and an extra place for the two spellings to
# disagree.
node scripts/src/marketplace.ts "$@"
