#!/usr/bin/env bash
#MISE description="Generate .claude-plugin/marketplace.json from the plugin manifests (--check to assert freshness)"
#MISE dir="{{ config_root }}"

# Projects the 13 plugins/<name>/.claude-plugin/plugin.json manifests into the
# marketplace manifest Claude Code reads when this repo is added as a
# marketplace. It lives at the repo ROOT, not under plugins/, because every
# `source` inside it is root-relative and would resolve nowhere from anywhere
# else.
#
# The output is committed on purpose: what a user installs is then inspectable
# and diffable in review. That is also the only reason `--check` has to exist — a
# generated-and-committed file has no other staleness guarantee, so this mode is
# the successor to the retired `plugins:render-clean`, narrowed to the one file
# still generated now that nothing renders.
#
# Run with no build step: node strips the TypeScript types directly. That needs
# node >= 22.6, which .config/mise.toml already pins.

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

# "$@" so --check passes straight through. Deliberately not a #USAGE flag: mise
# would then own the parsing and the script would have to reconstruct the
# argument, which buys a help line and an extra place for the two spellings to
# disagree.
node scripts/src/marketplace.ts "$@"
