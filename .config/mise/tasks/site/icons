#!/usr/bin/env bash
#MISE description="Rasterize the favicon set from public/brand/vwf-favicon.svg"
#MISE dir="{{ config_root }}/site"

set -euo pipefail

SRC="$PWD/public/brand/vwf-favicon.svg"
OUT="$PWD/public"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# The touch icon must be full-bleed: iOS masks the corners itself and paints
# whatever is transparent black, so the rounded tile is squared off first.
# BSD sed, so no -i.
sed 's/rx="14"/rx="0"/' "$SRC" > "$TMP/square.svg"

# sharp-cli and png-to-ico are one-off tools, never repo dependencies, and are
# run from $TMP so nothing resolves against the workspace. --density renders the
# 64px SVG large enough that every size is a downscale, never an enlargement.
mkdir -p "$TMP/stage" "$TMP/out"

# sharp-cli names its output after its input and demands an output directory, so
# each size is staged under the stem it should be written as.
render() {
  local svg="$1" size="$2" stem="$3"
  cp "$svg" "$TMP/stage/$stem.svg"
  (cd "$TMP" && pnpx sharp-cli@6 \
    --input "stage/$stem.svg" \
    --output "out" \
    --density 1200 \
    --format png \
    resize "$size" "$size" --fit contain --background "rgba(0,0,0,0)")
}

render "$SRC" 512 icon-512
render "$SRC" 192 icon-192
render "$TMP/square.svg" 180 apple-touch-icon
render "$SRC" 16 ico-16
render "$SRC" 32 ico-32
render "$SRC" 48 ico-48

# The plan says `pnpx png-to-ico@3 ico-16.png ico-32.png ico-48.png`, and that
# cannot produce the 16/32/48 ICO the same plan asks for: png-to-ico's bin
# passes only `argv._[0]` to the library, so the 32 and 48 arguments are
# dropped, and the single-path branch upscales that one PNG to 256 and emits
# 48/32/16/256 — four layers, all resampled from the 16 px input. `pnpm dlx
# --package=png-to-ico@3 node -e …` does not help either: the dlx directory is
# not on node's resolution path, so the import fails. The library entry takes an
# array and writes exactly those layers, so the package is installed into $TMP —
# never into this repo — and driven by a one-line script.
(
  cd "$TMP" && pnpm init > /dev/null &&
    pnpm add --silent png-to-ico@3 > /dev/null
)
node --input-type=module -e "
  import pngToIco from '$TMP/node_modules/png-to-ico/index.js';
  const sizes = [16, 32, 48].map(s => '$TMP/out/ico-' + s + '.png');
  process.stdout.write(await pngToIco(sizes));
" > "$TMP/favicon.ico"

mv "$TMP/out/icon-512.png" "$TMP/out/icon-192.png" \
  "$TMP/out/apple-touch-icon.png" "$TMP/favicon.ico" "$OUT/"

ls -l "$OUT/favicon.ico" "$OUT/apple-touch-icon.png" "$OUT/icon-192.png" \
  "$OUT/icon-512.png"
