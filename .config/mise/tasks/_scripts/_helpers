#!/usr/bin/env bash
#MISE hide=true
# Helper functions for mise tasks
# Source this file in other tasks using: source "${SCRIPT_DIR}/_helpers"

# Color codes
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly RED='\033[0;31m'
readonly BOLD='\033[1m'
readonly NORMAL='\033[0m'

# Emojis
readonly SUCCESS_EMOJI="✅"
readonly WARNING_EMOJI="⚠️"
readonly ERROR_EMOJI="🚫"
readonly SETTING_EMOJI="⚙️"
readonly INSTALL_EMOJI="🚀"
readonly PACKAGE_EMOJI="📦"
readonly CHECK_EMOJI="🩺"

# Print colored section header with new line
print_header() {
  local msg="$1"
  line_sep "="
  echo -e "${GREEN}${BOLD}${msg}${NORMAL}"
}

# Print colored section header without new line
print_header_wait() {
  local msg="$1"
  line_sep "="
  echo -en "${GREEN}${BOLD}${msg}${NORMAL}"
}

# Print colored section sub-header with new line
print_subheader() {
  local msg="$1"
  line_sep "-"
  echo -e "${GREEN}${BOLD}${msg}${NORMAL}"
}

# Print colored section sub-header without new line
print_subheader_wait() {
  local msg="$1"
  line_sep "-"
  echo -en "${GREEN}${BOLD}${msg}${NORMAL}"
}

# Print green colored text with new line
print_green() {
  local msg="$1"
  echo -e "${GREEN}${msg}${NORMAL}"
}

# Print green colored text with new line
print_green_wait() {
  local msg="$1"
  echo -en "${GREEN}${msg}${NORMAL}"
}

# Print yellow colored text with new line
print_yellow() {
  local msg="$1"
  echo -e "${YELLOW}${msg}${NORMAL}"
}

# Print yellow colored text without new line
print_yellow_wait() {
  local msg="$1"
  echo -en "${YELLOW}${msg}${NORMAL}"
}

# Print red colored text with new line
print_red() {
  local msg="$1"
  echo -e "${RED}${msg}${NORMAL}"
}

# Print red colored text without new line
print_red_wait() {
  local msg="$1"
  echo -en "${RED}${msg}${NORMAL}"
}

# Print text with new line
print_normal() {
  local msg="$1"
  echo -e "${NORMAL}${msg}${NORMAL}"
}

# Print text without new line
print_normal_wait() {
  local msg="$1"
  echo -en "${NORMAL}${msg}${NORMAL}"
}

# Print empty line
print_newline() {
  echo ""
}

print_warn() {
  local msg="$1"
  echo -e "${WARNING_EMOJI} ${YELLOW}${BOLD}${msg}${NORMAL}"
}

print_error() {
  local msg="$1"
  echo -e "${ERROR_EMOJI} ${RED}${BOLD}${msg}${NORMAL}"
}

print_success() {
  local msg="$1"
  echo -e "${SUCCESS_EMOJI} ${GREEN}${BOLD}${msg}${NORMAL}"
}

# Print line separator
line_sep() {
  local COL
  # `|| COL=` is load-bearing: callers run under `set -euo pipefail`, and with no
  # TTY `stty` exits non-zero — pipefail hands that status to the assignment and
  # `set -e` kills the task before the `${COL:-80}` fallback below is ever read.
  # Redirecting stderr hides the message, not the status. This is every
  # non-interactive run: CI, and any task invoked through a pipe.
  COL=$(stty size 2>/dev/null | awk '{print $2}') || COL=
  # Build a string of spaces equal to width, then replace with '='
  local line
  printf -v line '%*s' "${COL:-80}" ''
  printf '%s\n' "${line// /$1}"
}
