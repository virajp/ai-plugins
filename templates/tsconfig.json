{
  // Templates are authored prose, not a package — this project exists purely so
  // the one thing under `templates/` that is real code gets type-checked.
  //
  // OpenCode plugin modules ship as authored TypeScript (its loader is Bun, and
  // it discovers `{plugin,plugins}/*.{ts,js}`), so nothing transforms them on
  // the way out. Without this project they would carry the extension and none
  // of the guarantee.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/",
  },
  "include": ["*/opencode-plugin/*.ts"],
}
