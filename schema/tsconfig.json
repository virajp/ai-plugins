{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // No `baseUrl`: TypeScript 7 removed it (TS5102). The house tsconfig
    // doctrine in plugins/typescript still specifies it and is now stale.
    "rootDir": ".",
    "outDir": "./dist/",
    "paths": { "@/*": ["./src/*"] },
  },
  "include": ["src/**/*.ts"],
}
