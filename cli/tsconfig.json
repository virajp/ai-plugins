{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // No `baseUrl`: removed in TypeScript 7 (TS5102).
    "rootDir": ".",
    "outDir": "./dist/",
    "paths": { "@/*": ["./src/*"] },
  },
  // No project `references`, for the same reason as renderer/: nothing here emits
  // via `tsc --build` — tsup bundles this package and `@ai-plugins/schema`
  // resolves through the workspace link.
  "include": ["src/**/*.ts"],
}
