{
  "configSchema": "https://opencode.ai/config.json",
  "name": "typescript",
  "version": "3.1.0",
  "lsp": {
    "typescript": {
      "command": [
        "mise",
        "x",
        "--",
        "pnpm",
        "--package=typescript",
        "--package=typescript-language-server",
        "dlx",
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".cjs",
        ".cts",
        ".js",
        ".jsx",
        ".mjs",
        ".mts",
        ".ts",
        ".tsx"
      ]
    }
  }
}
