{
  "configSchema": "https://opencode.ai/config.json",
  "name": "vwf",
  "version": "15.1.0",
  "dependencies": [
    "andrej-karpathy-skills",
    "devtools"
  ],
  "mcp": {
    "mempalace": {
      "type": "remote",
      "url": "http://127.0.0.1:8765/mcp"
    },
    "context7": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    }
  }
}
