{
  "$schema": "https://www.schemastore.org/claude-code-plugin-manifest.json",
  "dependencies": [
    {
      "marketplace": "virajp-plugins",
      "name": "mempalace"
    },
    {
      "marketplace": "virajp-plugins",
      "name": "andrej-karpathy-skills"
    },
    {
      "marketplace": "virajp-plugins",
      "name": "mise"
    }
  ],
  "mcpServers": {
    "mempalace": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp"
    },
    "context7": {
      "args": [
        "dlx",
        "@upstash/context7-mcp"
      ],
      "command": "pnpm",
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    }
  },
  "name": "vwf"
}
