{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "command -v rtk >/dev/null 2>&1 && rtk hook claude || true",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mempalace-checkpoint.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mempalace-precompact.sh",
            "timeout": 90,
            "type": "command"
          }
        ]
      }
    ]
  }
}
