{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // No `baseUrl`: removed in TypeScript 7 (TS5102).
    "rootDir": ".",
    "outDir": "./dist/",
    "paths": { "@/*": ["./src/*"] },
  },
  // No project `references`: nothing here emits via `tsc --build` (Node strips
  // types directly and tsup bundles the CLI), and a reference would require the
  // schema package to enable emit purely to satisfy TS6310. `@ai-plugins/schema`
  // resolves through the workspace link instead.
  "include": ["src/**/*.ts"],
}
