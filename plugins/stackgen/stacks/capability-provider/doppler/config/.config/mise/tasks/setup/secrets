#!/usr/bin/env bash

#MISE description="Scope this repo to its secrets project"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Setting up the secrets manager ..."

project="${DOPPLER_PROJECT:-}"
config="${DOPPLER_CONFIG:-}"

if [ -z "$project" ] || [ -z "$config" ]; then
  print_error "DOPPLER_PROJECT or DOPPLER_CONFIG is unset — .config/mise/conf.d/doppler.toml did not load"
  exit 1
fi

# A contributor without the CLI, or without a seat, still has to be able to run
# setup:all end to end — every task in this repo runs without the injector, and
# a machine that cannot scope yet is not a broken repo. Both checks below skip.
if ! command -v doppler >/dev/null 2>&1; then
  print_warn "doppler is not installed — skipping. Add it to .config/mise.dev.toml, then run: mise install"
  exit 0
fi

doppler --version

# `doppler me` is the cheapest authenticated call whose output is not a secret.
if ! doppler me >/dev/null 2>&1; then
  print_warn "doppler is not logged in — skipping. Run: doppler login && mise run setup:secrets"
  exit 0
fi

echo "Project: ${project}   Config: ${config}"

# --no-read-env so the scope is written from these flags rather than from
# whatever the current environment happens to hold, and --scope so the mapping
# is recorded for the repo root rather than for the shell's directory.
doppler setup --no-interactive --no-read-env \
  --project "$project" \
  --config "$config" \
  --scope "${MISE_PROJECT_ROOT}"

print_success "Secrets manager scoped to ${project}/${config}"
