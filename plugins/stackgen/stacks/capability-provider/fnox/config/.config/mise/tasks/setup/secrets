#!/usr/bin/env bash

#MISE description="Check this repo's secrets manager is ready"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Setting up the secrets manager ..."

# There is nothing to scope: the configuration is a committed file, not a
# per-machine mapping held by a vendor. So this task verifies that the CLI and
# the config are both present and tells the contributor where their material
# is expected to live.

config="${MISE_PROJECT_ROOT}/fnox.toml"

if ! command -v fnox >/dev/null 2>&1; then
  print_warn "fnox is not installed — skipping. Run: mise install"
  exit 0
fi

fnox --version

if [ ! -f "$config" ]; then
  print_warn "fnox.toml is missing from the repo root — skipping. fnox searches upward from the working directory, so the file belongs there and nowhere else."
  exit 0
fi

# The keychain service and prefix, read back from the config so the message
# cannot drift from the file. Never `fnox get`: its normal output is a secret
# VALUE, and a scrollback and a CI log are both more widely readable than the
# repo.
service="$(command grep -o 'service = "[^"]*"' "$config" | head -1 | command cut -d'"' -f2 || true)"
prefix="$(command grep -o 'prefix = "[^"]*"' "$config" | head -1 | command cut -d'"' -f2 || true)"

echo "Keychain service: ${service:-fnox}   prefix: ${prefix:-<none>}"
echo "Declare a secret in fnox.toml, then populate its keychain entry (fnox --help)."

print_success "Secrets manager ready"
