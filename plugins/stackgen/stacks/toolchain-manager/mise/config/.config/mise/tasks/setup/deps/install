#!/usr/bin/env bash

#MISE description="Install this repo's package-manager dependencies"
#MISE hide=true
#PLACEHOLDER

#USAGE flag "--clean" help="Delete installed dependencies and caches before installing"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/placeholder"

# The one required verb of `setup:deps:*`, and the only one that ships as a
# slot: every package manager installs from a lockfile, so a repo with a
# toolchain always has a fill for this and a repo without one never does.
#
# The overlay replaces this file with its package manager's install — and adds
# whichever of `upgrade` / `outdated` / `audit` / `cleanup` that manager
# actually has.

placeholder_notice "setup:deps:install" "no toolchain is pinned for this repo, so there are no packages to install"
