#!/usr/bin/env bash

#MISE description="Run the commit hooks over your changed files"
#MISE dir="{{ config_root }}"

#USAGE flag "--all" help="Run on every file in the repo (default: only what you changed)"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# **Run this BEFORE you stage.** The hooks rewrite files — a formatter reflows,
# a linter fixes — and the whole question is where those rewrites land. Run
# against the working tree first and they fold into the commit you were about to
# make; run them from the git hook after staging and you get a failed commit and
# a second "fix hooks" commit that means nothing to anyone reading the history.
#
# So the default file set is the working tree's changed files — staged AND
# unstaged, plus what is untracked — and not the index. `--diff-filter=d` drops
# deletions, which have no file left to check.
#
# `--all` is the safety-net form the merge tasks use, where the question is
# whether anything got past this.

CONFIG=".config/pre-commit-config.yaml"

if [ ! -f "${MISE_PROJECT_ROOT}/${CONFIG}" ]; then
  print_warn "No ${CONFIG} — nothing to run."
  exit 0
fi

if [[ "${usage_all:-false}" == "true" ]]; then
  pre-commit run --config "${CONFIG}" --all-files
  exit 0
fi

changed=()
while IFS= read -r file; do
  [ -n "${file}" ] && changed+=("${file}")
done < <(
  {
    git diff --name-only --diff-filter=d HEAD
    git ls-files --others --exclude-standard
  } | sort -u
)

if [ ${#changed[@]} -eq 0 ]; then
  print_success "No changed files to check."
  exit 0
fi

pre-commit run --config "${CONFIG}" --files "${changed[@]}"
