#!/usr/bin/env bash

#MISE description="Lint the repo's files"
#MISE dir="{{ config_root }}"
#PLACEHOLDER

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/placeholder"

# A slot, unlike its sibling `code:format`. Formatting has a default that costs
# nothing — dprint is one binary and every repo has markdown. Linting does not:
# every linter worth running is a language's own, and the one this ecosystem
# uses for prose would drag a package manager into a repo that holds only docs.
#
# So the name is the contract and the stack overlay brings the linter.

placeholder_notice "code:lint" "no linter is pinned for this repo"
