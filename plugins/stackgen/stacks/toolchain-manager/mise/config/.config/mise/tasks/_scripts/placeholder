#!/usr/bin/env bash

#MISE description="Renders the prompt for tasks no stack has filled yet"
#MISE hide=true

# Sourced by every task that is a SLOT with no fill — a task whose name is part
# of the contract but whose mechanism depends on a stack nobody has pinned.
#
# A placeholder ALWAYS exits 0. An unconfigured repo must still be able to run
# `mise run code:all` and `mise run setup:all` end to end: the docs a product is
# defined in are formatted, linted and gated from day one, and the unfilled
# slots announce themselves rather than halting the aggregator that called them.
#
# A task stops being a placeholder by being OVERWRITTEN — the stack overlay
# ships its own file at the same path, marker and all gone. Nothing edits a
# placeholder in place.

# Sourced directly as well as after `helpers`, so it pulls its own printers in
# rather than assuming the caller already did. The guard inside `helpers` makes
# the second source a no-op.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

readonly PLACEHOLDER_MARKER="#PLACEHOLDER"

# List every task file in this repo still carrying the marker, as task names.
#
# `_scripts/` is excluded because this file names the marker in order to search
# for it — without the exclusion the helper reports itself as unconfigured.
placeholder_tasks() {
  local root="${MISE_PROJECT_ROOT}/.config/mise/tasks"
  [ -d "$root" ] || return 0
  # `grep -rl` exits 1 on no match — the state of a fully configured repo, and
  # an empty list rather than an error. Under `pipefail` that status would be
  # the pipeline's, then the function's, then the caller's assignment's, and
  # `set -e` would kill the notice instead of letting it print.
  { grep -rl --exclude-dir=_scripts -- "${PLACEHOLDER_MARKER}" "$root" 2>/dev/null || true; } |
    command sed -e "s#^${root}/##" -e 's#/#:#g' |
    command sort
}

# placeholder_notice <task-name> <one-line reason>
#
# Prints the reason, then the repo-wide list and the commands that resolve it.
# The list is deliberately repo-wide rather than per-task: a user who hits one
# unfilled slot is going to hit the rest, and one round of setup answers all of
# them.
placeholder_notice() {
  local task="$1" reason="$2"
  local pending
  pending="$(placeholder_tasks | command tr '\n' ' ')"

  print_warn "${task} is not configured yet — ${reason}"
  print_newline

  if [ -n "${pending// /}" ]; then
    print_yellow "Unconfigured in this repo: ${pending% }"
    print_newline
  fi

  print_yellow "To configure them:"
  print_yellow "  /vwf:architecture   pin this repo's stack axes (do this first)"
  print_yellow "  /stackgen           materialize the packs that fill them"
  print_newline

  return 0
}
