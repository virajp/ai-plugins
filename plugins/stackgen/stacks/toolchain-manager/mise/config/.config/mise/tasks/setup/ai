#!/usr/bin/env bash

#MISE description="Install and verify the AI tooling this repo expects"
#MISE hide=true

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Claude Code itself is installed per machine, not per repo — this task verifies
# it is there and reconciles the plugin side, which IS per repo.
#
# Driven through `claude` directly rather than through an installer wrapper, so
# the task needs no package manager and no network beyond git.

if ! command -v claude >/dev/null 2>&1; then
  print_warn "claude is not on PATH — skipping AI setup."
  print_yellow "Install it from https://claude.com/code, then re-run this task."
  exit 0
fi

# Marketplaces this repo installs plugins from, one row per marketplace as
# `<github-source>|<marketplace-name>`. The name is what the marketplace's own
# manifest declares and what `claude plugin marketplace update` takes; it is not
# derivable from the source (the repo is `claude-plugins`, the marketplace is
# `virajp-plugins`). Registering one already registered is a no-op, so this
# stays idempotent.
MARKETPLACES=(
  "virajp/claude-plugins|virajp-plugins"
)

# Plugins this repo wants at PROJECT scope, as `<name>@<marketplace>`. Leave the
# array empty for a repo whose plugins are all user-scoped.
PROJECT_PLUGINS=()

print_header "Refreshing plugin marketplaces ..."
for row in "${MARKETPLACES[@]}"; do
  source="${row%%|*}"
  name="${row##*|}"
  claude plugin marketplace add "${source}" >/dev/null 2>&1 || true
  claude plugin marketplace update "${name}" >/dev/null 2>&1 || true
  print_yellow "- ${source} (${name})"
done

if [ ${#PROJECT_PLUGINS[@]} -gt 0 ]; then
  print_header "Installing project-scoped plugins ..."
  for plugin in "${PROJECT_PLUGINS[@]}"; do
    print_wait "- ${plugin} ... "
    claude plugin install --scope project "${plugin}" >/dev/null
    print_ok
  done
fi

print_header "Updating installed plugins ..."
claude plugin update --all >/dev/null 2>&1 || true

print_header "Pruning plugins nothing references ..."
for scope in user project local; do
  claude plugin autoremove --scope "${scope}" --yes >/dev/null 2>&1 || true
done

print_header "AI setup done"
