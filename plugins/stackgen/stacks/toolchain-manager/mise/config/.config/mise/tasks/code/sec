#!/usr/bin/env bash

#MISE description="Security scan the repo"
#MISE dir="{{ config_root }}"
#PLACEHOLDER

#USAGE flag "--debug" help="emit debug logs"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/placeholder"

# Scanning is mandatory; the scanners are a choice. This file used to hardcode
# a dependency scanner and a secret scanner, which meant every repo scaffolded
# from the template inherited two tools it never picked — and a repo that picked
# differently had to delete the task rather than fill it.
#
# The slot is the contract: before a change lands, this repo's dependencies are
# checked for known vulnerabilities and its tree for committed secrets. Which
# scanners do that comes from the pinned repo-gate components.

placeholder_notice "code:sec" "no security scanners are pinned for this repo"
