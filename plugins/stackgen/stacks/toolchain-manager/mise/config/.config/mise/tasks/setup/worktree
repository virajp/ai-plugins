#!/usr/bin/env bash

#MISE description="Initialise a fresh git worktree (lighter than setup:all)"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# vwf's git-workflow probes for this task by name before falling back to
# `setup:all`, so the name is part of a contract that already ships — a repo
# without it silently takes the slower path.
#
# The difference from `setup:all` is scope, not depth: a fresh worktree shares
# the machine's tools and the repo's history, so it needs its members checked
# out, its secrets reachable and its dependencies installed, and nothing else.
# No tool upgrades, no hook installation, no plugin reconciliation.

print_header "Checking out members ..."
git -C "${MISE_PROJECT_ROOT}" submodule update --init --recursive

print_header "Installing pinned tools ..."
mise install

print_header "Setting up secrets ..."
mise run setup:secrets

# `--frozen` on purpose: a worktree is a place to work on a branch, not a place
# to move the lockfile. An install that resolved differently here would make the
# branch's dependency set an accident of which worktree ran first.
print_header "Installing dependencies ..."
mise run setup:deps:install --frozen

print_header "Worktree ready!"
