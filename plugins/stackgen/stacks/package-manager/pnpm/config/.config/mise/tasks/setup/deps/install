#!/usr/bin/env bash

#MISE description="Install dependencies from the lockfile"
#MISE hide=true

#USAGE flag "--frozen" help="fail rather than write the lockfile"

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Fills the `setup:deps:install` slot. `--frozen` is the contract's name for
# "the lockfile is the input, not the output" — the mode a fresh worktree and CI
# both want, and the one that turns a stale lockfile into a failure instead of a
# silent rewrite.

install_args=(--aggregate-output --child-concurrency 10 --network-concurrency 10 --recursive)
if [[ "${usage_frozen:-false}" == "true" ]]; then
  install_args+=(--frozen-lockfile)
fi

pnpm install "${install_args[@]}"
