#!/usr/bin/env bash

#MISE description="Move the lockfile forward, then re-install"
#MISE hide=true

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# The sync afterwards is not optional: `uv lock --upgrade` rewrites the lockfile
# without touching the virtualenv, so skipping it leaves the environment
# describing the previous resolution while the diff claims otherwise.
#
# No header: the aggregator `setup:deps:all` already frames each verb with its
# own subheader, so one here would invert the hierarchy. The subheaders below
# frame the steps inside this task.

print_subheader "Resolving the latest versions ..."
uv lock --upgrade

print_subheader "Re-installing from the lockfile ..."
uv sync --all-extras
