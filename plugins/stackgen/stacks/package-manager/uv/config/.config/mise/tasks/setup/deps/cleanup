#!/usr/bin/env bash

#MISE description="Delete the virtualenv and uv caches"
#MISE hide=true

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Was inline in the old `python/setup/all` as a bare `rm -rf .venv`. It is a
# task now because `setup:deps:all --clean` calls this verb by name, the same
# way it does for every other overlay.

print_header "Removing .venv ..."
rm -rf .venv || true

print_header "Pruning the uv cache ..."
uv cache prune || true
