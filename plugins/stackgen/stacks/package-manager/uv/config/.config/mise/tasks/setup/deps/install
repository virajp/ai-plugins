#!/usr/bin/env bash

#MISE description="Install dependencies from the lockfile"
#MISE hide=true

#USAGE flag "--frozen" help="fail rather than write the lockfile"

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Fills the `setup:deps:install` slot. `--frozen` is the contract's name for
# "the lockfile is the input, not the output": uv re-locks during a plain sync
# whenever the manifest has drifted, which is exactly the silent rewrite a fresh
# worktree and CI both need to see fail instead.
#
# The flag maps to uv's `--locked`, NOT to its `--frozen`. uv's `--frozen` skips
# resolution entirely and reads a stale lockfile without complaint — it declines
# to write, but it also declines to notice, which is the opposite of what the
# contract's flag promises. `--locked` is the one that errors on drift.

install_args=(--all-extras)
if [[ "${usage_frozen:-false}" == "true" ]]; then
  install_args+=(--locked)
fi

uv sync "${install_args[@]}"
