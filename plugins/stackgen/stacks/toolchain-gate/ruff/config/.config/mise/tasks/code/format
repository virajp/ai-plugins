#!/usr/bin/env bash

#MISE description="Check or format the repo's files"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Overlays the toolchain manager's `code:format`. dprint keeps the repo's
# markdown, YAML and TOML — the docs a Python project is defined in do not stop
# needing a formatter once there are sources — and ruff takes the `.py` files it
# has no opinion about.
#
# ruff runs through `uv run` rather than a global install so the version that
# formats is the one the lockfile pins, which is also the one CI uses.

if [[ "${usage_debug:-false}" == "true" ]]; then
  log_level="debug"
else
  log_level="warn"
fi

ruff_args=()
if [[ "${usage_fix:-false}" == "true" ]]; then
  action="fmt"
else
  action="check"
  ruff_args=(--check)
fi

print_header "Formatting files ..."

print_subheader "Formatting with dprint ..."
dprint "${action}" \
  --config .config/dprint.json \
  --allow-no-files \
  --log-level "${log_level}"

print_subheader "Formatting Python sources ..."
uv run ruff format ${ruff_args[@]+"${ruff_args[@]}"} .
