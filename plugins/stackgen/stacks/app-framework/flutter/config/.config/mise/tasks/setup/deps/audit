#!/usr/bin/env bash

#MISE description="Report known vulnerabilities in the dependency tree"
#MISE hide=true

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# An explicit no-op, not an omission. `pub` ships no advisory command — there is
# no `pub audit` — so this slot has nothing to run. Saying so here is the point:
# leaving the file out would leave the manager's placeholder in place, which
# reports that no package manager is pinned. That is false for a Flutter repo,
# and it is the kind of false that reads as "someone forgot to finish setup".

print_warn "setup:deps:audit: pub ships no advisory command, so there is nothing to audit."
print_yellow "Vulnerabilities in the resolved tree are covered by the repo's SCA gate, if one is pinned."
