#!/usr/bin/env bash

#MISE description="Move the lockfile forward, then re-install"
#MISE hide=true

set -euo pipefail
# helpers ships in the toolchain-manager pack, not this one, so there is no
# path here for -x to follow.
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# `--major-versions` rewrites the constraints in `pubspec.yaml` as well as
# `pubspec.lock`. Without it `pub upgrade` only moves within the ranges already
# written, which is what `setup:deps:install` would have resolved anyway — so
# the task would move nothing and still claim to. The rewritten constraints are
# the review surface, the same way the lockfile diff is elsewhere.
#
# One command, so no header: whatever called it — `setup:deps:all`, or a person
# — frames it.

flutter pub upgrade --major-versions
